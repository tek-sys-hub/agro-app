# AgroSmart Environment Variables Template
# Copy this file to .env and replace with your actual API credentials.

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-actual-supabase-anon-key-here

# OpenWeatherMap API Configuration
OPENWEATHER_API_KEY=your-openweather-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
DEFAULT_LOCATION_NAME=Kanchanpur, Nepal
DEFAULT_LATITUDE=28.9328
DEFAULT_LONGITUDE=80.1983
